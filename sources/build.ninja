# buildVariable: Build a variable font from a source file
rule buildVariable
  command = $
      /Users/vvmonsalve/Documents/03_TRABAJO/01-Specimens/roboto-delta/venv/bin/python3.14 $
      -m gftools.builder.jobrunner fontmake --output-path $out -o variable $
      $fontmake_type $in $args $stamp
  description = buildVariable

# fix: Run gftools-fix
rule fix
  command = $
      /Users/vvmonsalve/Documents/03_TRABAJO/01-Specimens/roboto-delta/venv/bin/python3.14 $
      -m gftools.builder.jobrunner gftools-fix-font -o $out $args $in $stamp
  description = fix

# exec: Run an arbitrary executable
rule exec
  command = $
      /Users/vvmonsalve/Documents/03_TRABAJO/01-Specimens/roboto-delta/venv/bin/python3.14 $
      -m gftools.builder.jobrunner $exe $args $stamp
  description = exec

# compress: Compress to webfont
rule compress
  command = $
      /Users/vvmonsalve/Documents/03_TRABAJO/01-Specimens/roboto-delta/venv/bin/python3.14 $
      -m gftools.builder.jobrunner fonttools ttLib.woff2 compress -o $out $
      $in $stamp
  description = compress

# buildStat: Build a STAT table from one or more source files
rule buildSTAT-operation
  command = gftools-gen-stat --out $tempdir $args -- $in && mv $finalfile $
      $out $stamp
rule buildSTAT-postprocess
  command = gftools-gen-stat --inplace $args -- $in $stamp

# avar2ToAvar1: Flatten an avar2 variable font into an avar1 variable font
rule avar2ToAvar1
  command = $
      /Users/vvmonsalve/Documents/03_TRABAJO/01-Specimens/roboto-delta/venv/bin/python3.14 $
      -m gftools.builder.jobrunner gftools-avar2-to-avar1 $args -o $out $in $
      $stamp
  description = avar2ToAvar1

# rename: Rename a font
rule rename
  command = $
      /Users/vvmonsalve/Documents/03_TRABAJO/01-Specimens/roboto-delta/venv/bin/python3.14 $
      -m gftools.builder.jobrunner gftools-rename-font -o $out $args $in $
      "$name" $stamp
  description = rename

# copy: Copy a file
rule copy
  command = $
      /Users/vvmonsalve/Documents/03_TRABAJO/01-Specimens/roboto-delta/venv/bin/python3.14 $
      -m gftools.builder.jobrunner cp $in $out $stamp
  description = copy

# Generating /var/folders/2k/pym6nn_d3cx0hp9sq0n48sqh0000gn/T/tmpqps38mhj
build /var/folders/2k/pym6nn_d3cx0hp9sq0n48sqh0000gn/T/tmpqps38mhj: $
    buildVariable ./Roman/RobotoDelta.designspace
  operation = buildVariable
  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter --production-names $
      --no-check-compatibility
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
# Generating /var/folders/2k/pym6nn_d3cx0hp9sq0n48sqh0000gn/T/tmp0fhq7xln
build /var/folders/2k/pym6nn_d3cx0hp9sq0n48sqh0000gn/T/tmp0fhq7xln: $
    buildVariable ./Italic/RobotoDelta-Italic.designspace
  operation = buildVariable
  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter --production-names $
      --no-check-compatibility
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
