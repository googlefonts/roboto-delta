# buildVariable: Build a variable font from a source file
rule buildVariable
  command = /Users/marcfoley/Type/tools/venv/bin/python3.13 -m $
      gftools.builder.jobrunner fontmake --output-path $out -o variable $
      $fontmake_type $in $args $stamp
  description = buildVariable

# fix: Run gftools-fix
rule fix
  command = /Users/marcfoley/Type/tools/venv/bin/python3.13 -m $
      gftools.builder.jobrunner gftools-fix-font -o $out $args $in $stamp
  description = fix

# compress: Compress to webfont
rule compress
  command = /Users/marcfoley/Type/tools/venv/bin/python3.13 -m $
      gftools.builder.jobrunner fonttools ttLib.woff2 compress -o $out $in $
      $stamp
  description = compress

# buildStat: Build a STAT table from one or more source files
rule buildSTAT-operation
  command = gftools-gen-stat --out $tempdir $args -- $in && mv $finalfile $
      $out $stamp
rule buildSTAT-postprocess
  command = gftools-gen-stat --inplace $args -- $in $stamp

# avar2ToAvar1: Flatten an avar2 variable font into an avar1 variable font
rule avar2ToAvar1
  command = /Users/marcfoley/Type/tools/venv/bin/python3.13 -m $
      gftools.builder.jobrunner gftools-avar2-to-avar1 $args -o $out $in $
      $stamp
  description = avar2ToAvar1

# copy: Copy a file
rule copy
  command = /Users/marcfoley/Type/tools/venv/bin/python3.13 -m $
      gftools.builder.jobrunner cp $in $out $stamp
  description = copy

# Generating /var/folders/_k/fb06kkp570bfc7f32ml14q800000gn/T/tmp8b4sz1xn
build /var/folders/_k/fb06kkp570bfc7f32ml14q800000gn/T/tmp8b4sz1xn: $
    buildVariable ./Roman/RobotoDelta.designspace
  operation = buildVariable
  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter --no-check-compatibility
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
# Generating /var/folders/_k/fb06kkp570bfc7f32ml14q800000gn/T/tmpwchgscqp
build /var/folders/_k/fb06kkp570bfc7f32ml14q800000gn/T/tmpwchgscqp: $
    buildVariable ./Italic/RobotoDelta-Italic.designspace
  operation = buildVariable
  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter --no-check-compatibility
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
